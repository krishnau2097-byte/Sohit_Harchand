# Contact form delivery: set ONE option in .env.local

# Option A: any HTTPS webhook (e.g. Power Automate "When an HTTP request is received")
CONTACT_WEBHOOK_URL=

# Option B: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain you verified in Resend
CONTACT_FROM_EMAIL=
